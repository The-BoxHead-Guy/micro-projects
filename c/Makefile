# Macros
BIN_DIR = ../bin
COMPILER = gcc
CS50_LIB = -lcs50

# Custom names for the final executables
TARGET = $(BIN_DIR)/hello
TARGET_CONDITIONALS = $(BIN_DIR)/conditionals
TARGET_COMPARE = $(BIN_DIR)/compare
TARGET_AGREE = $(BIN_DIR)/agree
TARGET_CAT = $(BIN_DIR)/cat
TARGET_MARIO = $(BIN_DIR)/mario
TARGET_MARIO = $(BIN_DIR)/hi
TARGET_MARIO = $(BIN_DIR)/length
TARGET_MARIO = $(BIN_DIR)/string
TARGET_MARIO = $(BIN_DIR)/uppercase
TARGET_SEARCH = $(BIN_DIR)/search
TARGET_SEARCH_STRINGS = $(BIN_DIR)/search_strings
TARGET_PHONEBOOK = $(BIN_DIR)/phonebook
TARGET_COPY = $(BIN_DIR)/copy

# The source file(s) to compile
SRC = hello.c
SRC_CONDITIONALS = conditionals.c
SRC_COMPARE = compare.c
SRC_AGREE = agree.c
SRC_CAT = cat.c
SRC_MARIO = mario.c
SRC_MARIO = hi.c
SRC_MARIO = length.c
SRC_MARIO = string.c
SRC_MARIO = uppercase.c
SRC_SEARCH = search.c
SRC_SEARCH_STRINGS = search_strings.c
SRC_PHONEBOOK = phonebook.c
SRC_COPY = copy.c

# Allowed source files
ALLOWED = $(TARGET) $(TARGET_CONDITIONALS) $(TARGET_COMPARE) $(TARGET_AGREE) $(TARGET_CAT) $(TARGET_MARIO) $(TARGET_HI) $(TARGET_LENGTH) $(TARGET_STRING) $(TARGET_UPPERCASE) $(TARGET_SEARCH) $(TARGET_SEARCH_STRINGS) $(TARGET_PHONEBOOK) $(TARGET_COPY)

all: $(ALLOWED)

# Executables
$(TARGET): $(SRC)
	$(COMPILER) $(SRC) -o $(TARGET) $(CS50_LIB)

$(TARGET_CONDITIONALS): $(SRC_CONDITIONALS)
	$(COMPILER) $(SRC_CONDITIONALS) -o $(TARGET_CONDITIONALS) $(CS50_LIB)

$(TARGET_COMPARE): $(SRC_COMPARE)
	$(COMPILER) $(SRC_COMPARE) -o $(TARGET_COMPARE) $(CS50_LIB)

$(TARGET_AGREE): $(SRC_AGREE)
	$(COMPILER) -g $(SRC_AGREE) -o $(TARGET_AGREE) $(CS50_LIB)

$(TARGET_CAT): $(SRC_CAT)
	$(COMPILER) $(SRC_CAT) -o $(TARGET_CAT) $(CS50_LIB)

$(TARGET_MARIO): $(SRC_MARIO)
	$(COMPILER) $(SRC_MARIO) -o $(TARGET_MARIO) $(CS50_LIB)

$(TARGET_HI): $(SRC_HI)
	$(COMPILER) $(SRC_HI) -o $(TARGET_HI) $(CS50_LIB)

$(TARGET_LENGTH): $(SRC_LENGTH)
	$(COMPILER) $(SRC_LENGTH) -o $(TARGET_LENGTH) $(CS50_LIB)

$(TARGET_STRING): $(SRC_STRING)
	$(COMPILER) $(SRC_STRING) -o $(TARGET_STRING) $(CS50_LIB)

$(TARGET_UPPERCASE): $(SRC_UPPERCASE)
	$(COMPILER) $(SRC_UPPERCASE) -o $(TARGET_UPPERCASE) $(CS50_LIB)

$(TARGET_SEARCH): $(SRC_SEARCH)
	$(COMPILER) $(SRC_SEARCH) -o $(TARGET_SEARCH) $(CS50_LIB)

$(TARGET_SEARCH_STRINGS): $(SRC_SEARCH_STRINGS)
	$(COMPILER) $(SRC_SEARCH_STRINGS) -o $(TARGET_SEARCH_STRINGS) $(CS50_LIB)

$(TARGET_PHONEBOOK): $(SRC_PHONEBOOK)
	$(COMPILER) $(SRC_PHONEBOOK) -o $(TARGET_PHONEBOOK) $(CS50_LIB)

$(TARGET_COPY): $(SRC_COPY)
	$(COMPILER) $(SRC_COPY) -o $(TARGET_COPY) $(CS50_LIB)

clean:
	rm -f $(ALLOWED)
